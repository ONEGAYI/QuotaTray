{
  "request": {
    "url": "https://openrouter.ai/api/v1/credits",
    "headers": {
      "Authorization": "Bearer {{apiKey}}"
    }
  },
  "extract": {
    "planName": { "const": "OpenRouter" },
    "total": "$.data.total_credits",
    "used": "$.data.total_usage",
    "unit": { "const": "USD" }
  },
  "transforms": [
    { "op": "round", "field": "used", "digits": 2 }
  ]
}
