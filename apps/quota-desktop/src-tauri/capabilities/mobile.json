{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android 主 WebView：事件、主题、文档选择与受限外链权限",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ONEGAYI/QuotaTray" }]
    }
  ]
}
