# 构建产物
/target

# 前端（apps/quota-desktop）
node_modules/
dist/

# Tauri 自动生成的移动工程与 schema 快照（构建产物）
apps/quota-desktop/src-tauri/gen/
apps/quota-desktop/src-tauri/generated/

# 本地运行时数据（密文快照、缓存）
*.local.json

# 本地开发密钥（手动测试用，绝不入库）
.DevApiKey.json

# 日志与临时文件
*.log
*.tmp

# 编辑器/系统
.idea/
.vscode/
Thumbs.db
.DS_Store
.zcode/

# Python 字节码（file-tree 技能脚本）
__pycache__/
*.pyc

# 便携版本地烟测残留（发布 zip 内的这两个文件不进仓库）
portable.key
portable.marker

# Mimosa 扫描器本地状态（会话基线/报告，不入库）
.mimosa/
# tauri icon 生成的 iOS 图标集（本项目无 iOS 目标，防止误入库）
apps/quota-desktop/src-tauri/icons/ios/
